# Copy to .env and fill in. Never commit .env.
ENV=development
LOG_LEVEL=INFO

# Neon Postgres — dev database. asyncpg driver, sslmode=require.
DATABASE_URL=postgresql+asyncpg://user:password@ep-example.neon.tech/quotepulse?sslmode=require

# Neon Postgres — SEPARATE database/branch used only by `make test`. Never point this at DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://user:password@ep-example.neon.tech/quotepulse_test?sslmode=require

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000

# Gemini (embeddings + ActivityInsight extraction). Never commit a real key.
GEMINI_API_KEY=

# RQ job queue (Phase 2B) — a Redis-compatible server (docker-compose `redis` service, or a
# native/Memurai install for local dev).
REDIS_URL=redis://localhost:6379/0
